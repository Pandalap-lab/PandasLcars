<Application x:Class="PandaLcarsTactical.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Application.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries><XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" /></ResourceDictionary.MergedDictionaries>
   <Style x:Key="LayerButton" TargetType="ToggleButton">
    <Setter Property="FontSize" Value="10" /><Setter Property="Padding" Value="5,0" />
    <Setter Property="MinWidth" Value="0" /><Setter Property="MinHeight" Value="26" />
    <Setter Property="Foreground" Value="#9ACBFF" /><Setter Property="Background" Value="#06121D" />
    <Setter Property="BorderBrush" Value="#408AC6" /><Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
   </Style>
  </ResourceDictionary>
 </Application.Resources>
</Application>
